<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>opencover,cobertura,json</CoverletOutputFormat>
    <CoverletOutput>../../TestResults/</CoverletOutput>
    <Exclude>[GesMgmt.UnitTests]*</Exclude>
    <Include>[GesMgmt.Application]*,[GesMgmt.Domain]*,[GesMgmt.Infraestructure]*,[GesMgmt.WebAPI]*</Include>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GesMgmt.Application\GesMgmt.Application.csproj" />
    <ProjectReference Include="..\GesMgmt.Domain\GesMgmt.Domain.csproj" />
    <ProjectReference Include="..\GesMgmt.Infraestructure\GesMgmt.Infraestructure.csproj" />
    <ProjectReference Include="..\GesMgmt.WebAPI\GesMgmt.WebAPI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\GesMgmt.WebAPI\nlog.config" Link="nlog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
